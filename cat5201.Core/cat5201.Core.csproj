<Project Sdk="Microsoft.NET.Sdk">

  <!--
    cat5201.Core：UI 無關的共用核心（「一個核心 × 三介面」的核心層）。
    刻意 net8.0（非 -windows、無 WPF）：桌面 WPF / 未來 web 後端 / 手機都能引用同一份邏輯與契約。
    起點＝先放三介面共用的 DTO（WorkspaceSnapshot / MirrorCommand…），之後逐步把執行/編排/工作區核心搬進來。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Cat5201</RootNamespace>
  </PropertyGroup>


  <!-- B4-1：檔案 builders 搬入後所需套件（主專案仍保留自己的引用,重複無害） -->
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.0.2" />
    <PackageReference Include="Markdig" Version="1.3.0" />
    <PackageReference Include="QuestPDF" Version="2026.6.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
