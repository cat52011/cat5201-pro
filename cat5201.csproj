<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>ico_pack_256x256_1-Photoroom.ico</ApplicationIcon>

    <!-- 商品級中繼資料：檔案總管內容頁 / 工作管理員 / 關於顯示都吃這裡。 -->
    <AssemblyTitle>cat5201-pro — AI 工作台</AssemblyTitle>
    <Product>cat5201-pro</Product>
    <Company>cat5201</Company>
    <Authors>cat5201</Authors>
    <Description>節點畫布 × 多代理編排的 AI 工作台：串接 OpenAI / Claude / Gemini / Perplexity，可稽查每一步決策與成本，產出 PDF / DOCX / PPTX / XLSX / 圖片 / 影片。</Description>
    <Copyright>© 2026 cat5201</Copyright>
    <Version>1.8.1</Version>
    <FileVersion>1.8.1.0</FileVersion>
    <InformationalVersion>1.8.1-pro</InformationalVersion>
    <!-- tests\ 與 cat5201.Core\ 是獨立子專案；排除它們，避免主專案的預設 glob 把它們的 .cs 吸進來編。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;cat5201.Core\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Perplexity_logo.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ico_pack_256x256_1-Photoroom.ico" />
  </ItemGroup>

  <!-- 手機鏡像（§17 階段一）：WinExe 內嵌 Kestrel 開唯讀 web server，手機同區網瀏覽。 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- 讓測試專案能存取 internal 型別（如 UserPreferencesState），才能測個人化向後相容。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="cat5201.Tests" />
  </ItemGroup>

  <!-- UI 無關的共用核心（一個核心 × 三介面）。 -->
  <ItemGroup>
    <ProjectReference Include="cat5201.Core\cat5201.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.0.2" />
    <PackageReference Include="Markdig" Version="1.3.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="OpenAI" Version="2.8.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="QuestPDF" Version="2026.6.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Claude_logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\OpenAI_logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Gemini_logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Perplexity_logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
