<Window x:Class="Cat5201.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cat5201"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="cat5201-pro"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize">

    <Window.Resources>

        <SolidColorBrush x:Key="FileMenuBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="FileMenuBorder" Color="#D6D6D6"/>
        <SolidColorBrush x:Key="FileMenuText" Color="#222222"/>
        <SolidColorBrush x:Key="FileMenuDisabled" Color="#A0A0A0"/>

        <Style x:Key="FileContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{StaticResource FileMenuBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FileMenuBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="{StaticResource FileMenuText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border Background="Transparent"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="HeaderPresenter"
                                              ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="HeaderPresenter" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderPresenter" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource FileMenuDisabled}"/>
                                <Setter TargetName="HeaderPresenter" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileSeparatorStyle" TargetType="{x:Type Separator}">
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1"
                                Background="#EAEAEA"
                                CornerRadius="0.5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 膠囊型可勾選 chip（雲端上傳的檔案類型等）：未選＝淺灰膠囊，選中＝綠底描邊＋勾號，呼應 AppleSwitchStyle 的綠。 -->
        <Style x:Key="ChoiceChipStyle" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Chip"
                                CornerRadius="14"
                                Padding="12,5"
                                Background="#F4F4F6"
                                BorderThickness="1"
                                BorderBrush="#E4E4E8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Tick"
                                           Text="✓"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#1F7A4D"
                                           Visibility="Collapsed"
                                           Margin="0,0,5,0"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter x:Name="ChipContent"
                                                  VerticalAlignment="Center"
                                                  TextElement.FontSize="12"
                                                  TextElement.Foreground="#666"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#E8F5EE"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#2E9E5B"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ChipContent" Property="TextElement.Foreground" Value="#1F7A4D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">

                            <!-- 背景 -->
                            <Border x:Name="SwitchTrack"
                            CornerRadius="11"
                            Background="#D1D1D6"
                            BorderBrush="#D1D1D6"
                            BorderThickness="1"/>

                            <!-- 滑塊 -->
                            <Border x:Name="SwitchThumb"
                            Width="18"
                            Height="18"
                            CornerRadius="9"
                            Background="White"
                            HorizontalAlignment="Left"
                            Margin="2,2,0,2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4"
                                              ShadowDepth="1"
                                              Opacity="0.2"/>
                                </Border.Effect>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#34C759"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#34C759"/>

                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,2,2,2"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 任務路由下拉選單：圓角 pill 風格，與記憶輸入框、開關同一套視覺 -->
        <Style x:Key="RoutingComboItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ib" Background="Transparent" CornerRadius="7"
                                Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ib" Property="Background" Value="#F0F1F8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ib" Property="Background" Value="#ECEEFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoutingComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource RoutingComboItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd"
                                                Background="#F7F7F8"
                                                BorderBrush="#E4E4E7"
                                                BorderThickness="1"
                                                CornerRadius="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  Margin="11,0,0,0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"/>
                                                <Path Grid.Column="1"
                                                      Data="M0,0 L4,4 L8,0"
                                                      Stroke="#888"
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Margin="8,0,12,0"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#C9CAD2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="240"
                                        Background="White"
                                        BorderBrush="#E4E4E7"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Margin="0,4,0,0"
                                        Padding="5">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.16"/>
                                    </Border.Effect>
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <!-- 側邊欄 -->
        <Grid x:Name="Sidebar"
              Width="280"
              Background="#F0F0F0"
              HorizontalAlignment="Left"
              VerticalAlignment="Stretch"
              Panel.ZIndex="100">
            <Border Padding="12" Background="#F0F0F0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
        Width="22"
        Height="22"
        Margin="0,2,0,0"
        Background="Transparent"
        BorderThickness="0"
        Padding="0"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Cursor="Hand"
        ToolTip="新增"
        Click="NewFile_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <Viewbox x:Name="IconBox"
                         Width="20"
                         Height="20"
                         Stretch="Fill"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                                        <Canvas Width="18" Height="18">
                                            <Path Data="M9,3 L9,15"
                              Stroke="Black"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                                            <Path Data="M3,9 L15,9"
                              Stroke="Black"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="IconBox" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="IconBox" Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <ListBox x:Name="FileList"
                             Grid.Row="1"
                             Margin="0,10,0,10"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="FileList_MouseDoubleClick"
                             MouseRightButtonUp="FileList_MouseRightButtonUp">

                        <!-- 就地改名：平常顯示 TextBlock；右鍵→重新命名時原地換成輸入框（Enter 確認 / Esc 取消 / 失焦確認） -->
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock x:Name="NameText"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <!-- ChatGPT 風格：無邊框，只比背景深一點的半透明圓角底 -->
                                    <Border x:Name="EditorWrap"
                                            Visibility="Collapsed"
                                            Background="#10000000"
                                            CornerRadius="6"
                                            Margin="-6,-3"
                                            Padding="4,2">
                                        <TextBox x:Name="NameEditor"
                                                 Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="16"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 VerticalContentAlignment="Center"
                                                 IsVisibleChanged="FileRenameEditor_IsVisibleChanged"
                                                 KeyDown="FileRenameEditor_KeyDown"
                                                 LostFocus="FileRenameEditor_LostFocus"/>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter TargetName="NameText" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="EditorWrap" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollViewer}">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.Resources>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="14,12"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="#222"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="10">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E6E6E6"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#DCDCDC"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- 最近刪除入口：刪掉的存檔在這裡待 7 天，可完整復原 -->
                    <Button x:Name="TrashButton"
                            Grid.Row="2"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="OpenTrash_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="tt" Text="{TemplateBinding Content}"
                                           FontSize="12" Foreground="#8A8A84"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="tt" Property="Foreground" Value="#2A2A28"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Grid Grid.Row="2" Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="CurrentFileLabel"
                                   Grid.Column="0"
                                   Text="目前檔案：尚未建立"
                                   FontSize="12"
                                   Foreground="#555"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />

                        <!-- 左下角：齒輪 → 個人化設定 -->
                        <Button x:Name="SettingsGearButton"
                                Grid.Column="1"
                                Width="34" Height="34"
                                Margin="8,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="個人化設定"
                                Click="OpenSettings_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="gbd"
                                            Background="Transparent"
                                            CornerRadius="9">
                                        <Viewbox Width="20" Height="20"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path x:Name="gearIcon"
                                                      Fill="#5A5A5A"
                                                      Data="M19.14,12.94a7.49,7.49,0,0,0,.05-1,7.49,7.49,0,0,0-.05-1l2.11-1.65a.5.5,0,0,0,.12-.64l-2-3.46a.5.5,0,0,0-.61-.22l-2.49,1a7.32,7.32,0,0,0-1.69-1l-.38-2.65A.49.49,0,0,0,13.8,1H9.8a.49.49,0,0,0-.49.42L8.93,4.07a7.32,7.32,0,0,0-1.69,1l-2.49-1a.5.5,0,0,0-.61.22l-2,3.46a.5.5,0,0,0,.12.64L4.5,11a7.49,7.49,0,0,0,0,2L2.39,14.65a.5.5,0,0,0-.12.64l2,3.46a.5.5,0,0,0,.61.22l2.49-1a7.32,7.32,0,0,0,1.69,1l.38,2.65a.49.49,0,0,0,.49.42h4a.49.49,0,0,0,.49-.42l.38-2.65a7.32,7.32,0,0,0,1.69-1l2.49,1a.5.5,0,0,0,.61-.22l2-3.46a.5.5,0,0,0-.12-.64ZM12,15.5A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="gbd" Property="Background" Value="#E2E2E2"/>
                                            <Setter TargetName="gearIcon" Property="Fill" Value="#222"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 起始畫面 -->
        <Grid x:Name="StartUI"
              Margin="280,0,0,0"
              Background="White"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="StartMessage"
                           Grid.Row="1"
                           Text="讓我們有個新的開始！"
                           FontSize="28"
                           Foreground="#222"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <Button x:Name="StartButton"
                        Grid.Row="2"
                        Content="開始"
                        Width="100"
                        Height="36"
                        Background="Black"
                        Foreground="White"
                        BorderBrush="Black"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="StartButton_Click"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Padding="6,0"
                        Style="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="18"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.FontSize="16"
                                                  TextElement.Foreground="White"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                    <Button.Effect>
                        <DropShadowEffect BlurRadius="6"
                                          ShadowDepth="2"
                                          Opacity="0.25"/>
                    </Button.Effect>
                </Button>
            </Grid>
        </Grid>

        <!-- 主畫面 -->
        <Grid x:Name="MainUI"
              Visibility="Collapsed">

            <Border x:Name="Viewport"
                    ClipToBounds="True"
                    MouseDown="Viewport_MouseDown"
                    MouseWheel="Viewport_MouseWheel">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ViewportTranslate" X="140" Y="0"/>
                </Border.RenderTransform>

                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="White">
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#DDD" Thickness="1"/>
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="20,0"/>
                                        <LineGeometry StartPoint="0,0" EndPoint="0,20"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>

                <Canvas x:Name="MainCanvas" Background="Transparent"/>
            </Border>

            <!-- 側邊熱區 -->
            <Grid x:Name="HotZoneContainer"
                  Width="50" Height="200"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Background="Transparent"
                  Visibility="Collapsed"
                  Panel.ZIndex="101"
                  MouseEnter="HotZoneContainer_MouseEnter">

                <Border x:Name="HotZoneHitArea"
                        Width="20" Height="200"
                        Background="Transparent"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        MouseLeftButtonDown="ExpandSidebar">
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HotZoneBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1.0"
                                                     Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HotZoneBackground"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.3"
                                                     Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>

                <Border x:Name="HotZoneBackground"
                        Background="LightGray"
                        Opacity="0.3"
                        Width="5" Height="200"
                        CornerRadius="2.5"
                        Margin="15,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="Black"
                                          BlurRadius="8"
                                          ShadowDepth="2"
                                          Opacity="0.4"/>
                    </Border.Effect>
                </Border>
            </Grid>

            <!-- 右上角決策可視化視窗 -->

            <Border
    x:Name="DecisionPanel"
    Width="340"
    Height="260"
    CornerRadius="18"
    Background="White"
    BorderBrush="#E6E6E6"
    BorderThickness="1"
    Padding="14"
    SnapsToDevicePixels="True"
                HorizontalAlignment="Right"
VerticalAlignment="Top"
Margin="0,20,20,0"
                Panel.ZIndex="9995">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 上方固定區：標題 + 狀態 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="決策可視化"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#303030"
                       VerticalAlignment="Center"/>

                        <Button x:Name="DecisionPanelToggleButton"
                                Grid.Column="1"
                                Width="26"
                                Height="24"
                                Margin="0,0,8,0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="放大決策窗"
                                Click="DecisionPanelToggleButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Viewbox Width="14" Height="14">
                                <Path x:Name="DecisionPanelToggleIcon"
                                      Data="M2,6 L2,2 L6,2 M8,2 L12,2 L12,6 M12,8 L12,12 L8,12 M6,12 L2,12 L2,8"
                                      Stroke="#7A7A7A"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"/>
                            </Viewbox>
                        </Button>

                        <Border x:Name="DecisionStatusBadge"
                    Grid.Column="2"
                    Background="#EEF7EA"
                    CornerRadius="999"
                    Padding="10,4">
                            <TextBlock x:Name="DecisionStatusText"
                           Text="Rule Auto"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#2E6A2E"/>
                        </Border>
                    </Grid>

                    <!-- 中間分隔 -->
                    <Border Grid.Row="1"
                Margin="0,8,0,0"
                Height="1"
                Background="#ECECEC"/>

                    <!-- 下方可上下捲動內容區 -->
                    <ScrollViewer Grid.Row="2"
              Margin="0,8,0,0"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              CanContentScroll="False"
              PanningMode="VerticalOnly">

                        <StackPanel Margin="0,0,6,0">

                            <!-- 模式 -->
                            <TextBlock Text="模式"
                   FontSize="12"
                   Foreground="#7A7A7A"
                   Margin="0,0,0,2"/>
                            <TextBlock x:Name="DecisionModeText"
                   Text="-"
                   FontSize="13"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="#2A2A2A"
                   Margin="0,0,0,10"/>

                            <TextBlock Text="Agent"
           FontSize="12"
           Foreground="#7A7A7A"
           Margin="0,0,0,2"/>

                            <TextBlock x:Name="DecisionAgentText"
           Text="-"
           FontSize="14"
           FontWeight="SemiBold"
           Foreground="#232323"
           Margin="0,0,0,10"/>

                            <!-- 策略 -->
                            <TextBlock Text="策略"
                   FontSize="12"
                   Foreground="#7A7A7A"
                   Margin="0,0,0,2"/>
                            <TextBlock x:Name="DecisionResolverText"
                   Text="-"
                   FontSize="13"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="#2A2A2A"
                   Margin="0,0,0,10"/>

                            <!-- 模型 -->
                            <TextBlock Text="模型"
                   FontSize="12"
                   Foreground="#7A7A7A"
                   Margin="0,0,0,2"/>
                            <TextBlock x:Name="DecisionModelText"
                   Text="-"
                   FontSize="13"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="#2A2A2A"
                   Margin="0,0,0,10"/>

                            <!-- 參與的模型／服務（來自逐筆帳目，不是只有選模型時那一個） -->
                            <TextBlock Text="這次實際參與"
                   FontSize="12"
                   Foreground="#7A7A7A"
                   Margin="0,0,0,2"/>
                            <TextBlock x:Name="DecisionParticipantsText"
                   Text="-"
                   FontSize="12"
                   TextWrapping="Wrap"
                   LineHeight="17"
                   Foreground="#2A2A2A"
                   Margin="0,0,0,10"/>

                            <!-- 任務 -->
                            <TextBlock Text="任務"
                   FontSize="12"
                   Foreground="#7A7A7A"
                   Margin="0,0,0,2"/>
                            <TextBlock x:Name="DecisionTaskText"
                   Text="-"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="#2A2A2A"
                   Margin="0,0,0,10"/>

                            <!-- Reason -->
                            <TextBlock Text="Reason"
                   FontSize="12"
                   Foreground="#7A7A7A"
                   Margin="0,0,0,2"/>
                            <TextBlock x:Name="DecisionReasonText"
                   Text="-"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="#2A2A2A"
                   Margin="0,0,0,10"/>

                            <!-- Keywords -->
                            <TextBlock Text="Keywords"
                   FontSize="12"
                   Foreground="#7A7A7A"
                   Margin="0,0,0,2"/>
                            <TextBlock x:Name="DecisionKeywordsText"
                   Text="-"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="#2A2A2A"
                   Margin="0,0,0,10"/>

                            <!-- Capability / Trace -->
                            <TextBlock Text="Capability / Trace"
                   FontSize="12"
                   Foreground="#7A7A7A"
                   Margin="0,0,0,2"/>
                            <TextBlock x:Name="DecisionExtraText"
                   Text="-"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="#2A2A2A"
                   Margin="0,0,0,14"/>

                            <!-- Timeline -->
                            <Border Height="1"
                Background="#ECECEC"
                Margin="0,0,0,12"/>

                            <TextBlock Text="Decision Timeline"
                   FontSize="12"
                   Foreground="#7A7A7A"
                   Margin="0,0,0,8"/>

                            <StackPanel x:Name="DecisionTimelineHost"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右下角 API 餘額小面板（在自動模型開關上方；決策窗圖層比它高，開啟時會蓋住它） -->
            <Border x:Name="ApiBalancePanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,18,66"
                    Padding="12,9"
                    MinWidth="170"
                    MaxWidth="260"
                    CornerRadius="14"
                    Background="#FBFBFA"
                    BorderBrush="#E0E0DC"
                    BorderThickness="1"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    Panel.ZIndex="9990"
                    MouseLeftButtonUp="ApiBalancePanel_Click"
                    ToolTip="點一下開啟 API 狀態頁（填儲值金額、重新檢查）">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.10"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="API 餘額"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#8A8A84"
                               Margin="0,0,0,6"/>

                    <ItemsControl x:Name="ApiBalanceList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2" ToolTip="{Binding Tip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center"
                                             Fill="{Binding Dot}" Margin="0,0,7,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                               FontSize="12" Foreground="#3A3A36" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Amount}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#1F1F1C"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="ApiBalanceEmptyText"
                               Text="還沒有花費紀錄。到「個人化 → API」填入儲值金額，這裡就會顯示估計剩餘。"
                               FontSize="11"
                               Foreground="#A0A09A"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- 右下角自動模型開關 -->
            <Border x:Name="AutoModelSwitchPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,65,18"
                    Padding="10,7"
                    CornerRadius="22"
                    Background="#F7F7F7"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    Panel.ZIndex="9999">

                <StackPanel Orientation="Horizontal"
            VerticalAlignment="Center">

                    <TextBlock Text="API"
               VerticalAlignment="Center"
               Margin="0,0,6,0"
               FontSize="12.5"
               FontWeight="SemiBold"
               Foreground="#222"/>

                    <CheckBox x:Name="AdvancedAutoResolverSwitch"
              Style="{StaticResource AppleSwitchStyle}"
              VerticalAlignment="Center"
              Visibility="Collapsed"
              Checked="AdvancedAutoResolverSwitch_Checked"
              Unchecked="AdvancedAutoResolverSwitch_Unchecked"/>

                    <Border Margin="8,0,0,0"
            Width="1"
            Height="16"
            Background="#D9D9D9"
            VerticalAlignment="Center"/>

                    <TextBlock Text="Auto"
               VerticalAlignment="Center"
               Margin="8,0,6,0"
               FontSize="12.5"
               FontWeight="SemiBold"
               Foreground="#222"/>

                    <CheckBox x:Name="AutoModelSwitch"
              Style="{StaticResource AppleSwitchStyle}"
              VerticalAlignment="Center"
              Checked="AutoModelSwitch_Checked"
              Unchecked="AutoModelSwitch_Unchecked"/>

                </StackPanel>
            </Border>

            <!-- 右下角定位按鈕 -->
            <Button x:Name="CenterOnInitialButton"
                    Width="38" Height="38"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="18"
                    Background="#F5F5F5"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="CenterOnInitialButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="1"/>
                            <Path Data="M19,9 L19,29 M9,19 L29,19"
                                  Stroke="#444"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>

                <Button.Effect>
                    <DropShadowEffect BlurRadius="6"
                                      ShadowDepth="2"
                                      Opacity="0.22"/>
                </Button.Effect>
            </Button>
        </Grid>

        <!-- 個人化設定對話框（齒輪點開） -->
        <!-- 最近刪除：刪掉的存檔留 7 天，可完整復原 -->
        <Grid x:Name="TrashOverlay"
              Visibility="Collapsed"
              Panel.ZIndex="10001"
              Background="#55000000">

            <Border Width="540"
                    MaxHeight="560"
                    CornerRadius="18"
                    Background="White"
                    Padding="24,20"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.18"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="最近刪除" FontSize="16" FontWeight="SemiBold" Foreground="#2A2A28"/>
                        <Button Content="&#215;" HorizontalAlignment="Right" Width="28" Height="28"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                FontSize="15" Foreground="#8A8A84" Click="CloseTrash_Click"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Margin="0,8,0,14" FontSize="11.5" Foreground="#9A9A94" TextWrapping="Wrap"
                               Text="刪掉的存檔連同附件與該存檔的記憶都留在這裡，7 天後自動永久刪除。全域記憶不受影響。"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="TrashEmptyText" Visibility="Collapsed"
                                       Text="沒有最近刪除的存檔。" FontSize="12.5" Foreground="#A0A09A" Margin="0,8,0,0"/>

                            <ItemsControl x:Name="TrashList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FAFAF8" BorderBrush="#EAEAE6" BorderThickness="1"
                                                CornerRadius="10" Padding="14,11" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                               FontWeight="SemiBold" Foreground="#2A2A28"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#9A9A94"
                                                               Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <Button Grid.Column="1" Content="復原" Height="30" Margin="10,0,0,0"
                                                        FontSize="12" Cursor="Hand" Foreground="White" BorderThickness="0"
                                                        Background="#1F1F1C" Click="RestoreTrashItem_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="rb" Background="{TemplateBinding Background}"
                                                                    CornerRadius="8" Padding="16,0">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                  TextElement.Foreground="White"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="rb" Property="Background" Value="#3A3A35"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Button Grid.Column="2" Content="永久刪除" Height="30" Margin="8,0,0,0"
                                                        FontSize="12" Cursor="Hand" Foreground="#C0453B" BorderThickness="0"
                                                        Background="Transparent" Click="PurgeTrashItem_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="pb" Background="{TemplateBinding Background}"
                                                                    CornerRadius="8" Padding="12,0">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="pb" Property="Background" Value="#FBECEA"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SettingsOverlay"
              Visibility="Collapsed"
              Panel.ZIndex="10000"
              Background="#55000000"
              MouseLeftButtonDown="SettingsOverlay_BackgroundClick">

            <Border Width="440"
                    Height="600"
                    CornerRadius="18"
                    Background="White"
                    BorderBrush="#E6E6E6"
                    BorderThickness="1"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseLeftButtonDown="SettingsCard_Click">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.22"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 標題列 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="設定"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#303030"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="2"
                                Width="28" Height="28"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="關閉"
                                Click="CloseSettings_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="cbd" Background="Transparent" CornerRadius="8">
                                        <Path Data="M5,5 L15,15 M15,5 L5,15"
                                              Stroke="#888"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="cbd" Property="Background" Value="#EEEEEE"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Border Grid.Row="0" Height="1" Background="#ECECEC"
                            VerticalAlignment="Bottom" Margin="0,0,0,0"/>

                    <!-- 分頁切換：個人化 / API（右端是使用說明） -->
                    <Grid Grid.Row="1" Margin="0,12,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="TabPersonalizationBtn"
                                Content="個人化"
                                Height="32"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Background="#111"
                                Foreground="White"
                                BorderThickness="0"
                                Margin="0,0,8,0"
                                Click="ShowPersonalizationTab_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="18,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="TabApiBtn"
                                Content="API"
                                Height="32"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Background="#F1F1F3"
                                Foreground="#444"
                                BorderThickness="0"
                                Margin="0,0,8,0"
                                Click="ShowApiTab_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="18,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="TabSkillsBtn"
                                Content="Skills"
                                Height="32"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Background="#F1F1F3"
                                Foreground="#444"
                                BorderThickness="0"
                                Click="ShowSkillsTab_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="18,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 回報問題：打包日誌（金鑰已遮蔽）到桌面，任何分頁都看得到 -->
                        <Button x:Name="ReportProblemBtn"
                                Content="回報問題"
                                Height="32"
                                FontSize="12.5"
                                Cursor="Hand"
                                Background="Transparent"
                                Foreground="#777"
                                BorderThickness="0"
                                Margin="16,0,0,0"
                                ToolTip="把最近 7 天的日誌打包到桌面（自動遮蔽 API 金鑰），寄給開發者"
                                Click="ReportProblem_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="14,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#F1F1F3"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- 使用說明：原本是 API 分頁裡那顆「重新看一次首次啟動說明」。
                         它講的是資料會送去哪裡、金鑰怎麼存，任何分頁都該叫得出來。 -->
                    <Button x:Name="HelpBtn"
                            Grid.Column="1"
                            Width="26" Height="26"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Foreground="#8A8A8F"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="使用說明"
                            Click="ShowOnboarding_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="hbd" Background="{TemplateBinding Background}"
                                        BorderBrush="#DCDCE0" BorderThickness="1" CornerRadius="13">
                                    <TextBlock Text="?" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="hbd" Property="Background" Value="#F1F1F3"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    </Grid>

                    <!-- 個人化分頁（可捲動） -->
                    <ScrollViewer x:Name="PersonalizationScroll"
                                  Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,8,0,0">
                    <StackPanel Margin="0,8,4,0">
                        <TextBlock Text="記憶與偏好"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#444"
                                   Margin="0,0,0,8"/>

                        <Border CornerRadius="10"
                                Background="#F7F7F8"
                                BorderBrush="#E4E4E7"
                                BorderThickness="1"
                                Padding="10,8">
                            <TextBox x:Name="MemoryInput"
                                     Height="60"
                                     FontSize="13"
                                     Foreground="#222"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="Transparent"
                                     BorderThickness="0"/>
                        </Border>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="RememberButton"
                                    Grid.Column="0"
                                    Content="記住"
                                    Height="34"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Background="#111"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="RememberPreference_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              TextElement.Foreground="White"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#333"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="ClearMemoryButton"
                                    Grid.Column="2"
                                    Content="當前記憶"
                                    Height="34"
                                    FontSize="12.5"
                                    Cursor="Hand"
                                    Background="#F1F1F3"
                                    Foreground="#444"
                                    BorderThickness="0"
                                    Click="ToggleMemoryList_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="16,0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#E4E4E7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- 「當前記憶」展開區：點上面按鈕才顯示，逐條可刪、可一鍵清除 -->
                        <StackPanel x:Name="MemoryListPanel" Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock x:Name="MemoryEmptyHint"
                                       Text="目前沒有任何記憶。"
                                       Visibility="Collapsed"
                                       FontSize="12"
                                       Foreground="#9A9A9E"
                                       Margin="2,2,0,6"/>

                            <ItemsControl x:Name="PreferenceList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F4F5FB"
                                                CornerRadius="10"
                                                Padding="12,8"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="6" Height="6"
                                                        CornerRadius="3"
                                                        Background="#5B6CFF"
                                                        VerticalAlignment="Top"
                                                        Margin="0,6,9,0"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Display}"
                                                           FontSize="12.5"
                                                           Foreground="#3A3A40"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"/>

                                                <Button Grid.Column="2"
                                                        Width="22" Height="22"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Top"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        ToolTip="刪除這條記憶"
                                                        Tag="{Binding Key}"
                                                        Click="DeletePreference_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="dbd" Background="Transparent" CornerRadius="6">
                                                                <Path Data="M4,4 L12,12 M12,4 L4,12"
                                                                      Stroke="#9A9AA0"
                                                                      StrokeThickness="1.6"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="dbd" Property="Background" Value="#E2E3EC"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button x:Name="ClearAllMemoryButton"
                                    Content="一鍵清除全部"
                                    Height="32"
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Left"
                                    FontSize="12.5"
                                    Cursor="Hand"
                                    Background="#FBEAEA"
                                    Foreground="#B23B3B"
                                    BorderThickness="0"
                                    Click="ClearMemory_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="16,0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#F5D9D9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- §4 多階段任務自動展開 -->
                        <Border Height="1" Background="#ECECEC" Margin="0,16,0,0"/>

                        <TextBlock Text="多階段任務自動展開"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#444"
                                   Margin="0,14,0,8"/>

                        <StackPanel>
                            <RadioButton x:Name="DownstreamModeOneClick"
                                         GroupName="DownstreamAutoMode"
                                         Content="一鍵展開並自動執行（建議）"
                                         FontSize="12.5"
                                         Foreground="#333"
                                         Margin="0,3"
                                         Checked="DownstreamMode_Checked"/>
                            <RadioButton x:Name="DownstreamModeFullyAuto"
                                         GroupName="DownstreamAutoMode"
                                         Content="完全自動（送出後立即展開並執行）"
                                         FontSize="12.5"
                                         Foreground="#333"
                                         Margin="0,3"
                                         Checked="DownstreamMode_Checked"/>
                            <RadioButton x:Name="DownstreamModeOff"
                                         GroupName="DownstreamAutoMode"
                                         Content="關閉（只用單一節點作答）"
                                         FontSize="12.5"
                                         Foreground="#333"
                                         Margin="0,3"
                                         Checked="DownstreamMode_Checked"/>
                        </StackPanel>

                        <!-- 文件品質 -->
                        <Border Height="1" Background="#ECECEC" Margin="0,16,0,0"/>

                        <TextBlock Text="簡報與報告品質"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#444"
                                   Margin="0,14,0,2"/>

                        <!-- 差別是「誰來排版」，不只是快慢——而這會一路影響到預覽與單頁編輯。 -->
                        <TextBlock Text="最佳品質：Claude 親自設計每一頁。慢、貴，預覽是近似版面，單頁只能改文字。&#10;快速版：內建版型。快、便宜，預覽完全重現，單頁可連版面一起重做。&#10;沒金鑰或失敗時自動改用快速版。"
                                   FontSize="11.5"
                                   Foreground="#9A9A9E"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <StackPanel>
                            <RadioButton x:Name="DocumentEngineSkills"
                                         GroupName="DocumentEngine"
                                         Content="最佳品質（Claude 親自設計版面）"
                                         FontSize="12.5"
                                         Foreground="#333"
                                         Margin="0,3"
                                         Checked="DocumentEngine_Checked"/>
                            <RadioButton x:Name="DocumentEngineBuiltin"
                                         GroupName="DocumentEngine"
                                         Content="快速版（內建版型，快又便宜）"
                                         FontSize="12.5"
                                         Foreground="#333"
                                         Margin="0,3"
                                         Checked="DocumentEngine_Checked"/>
                        </StackPanel>

                        <!-- 簡報生成器 -->
                        <Border Height="1" Background="#ECECEC" Margin="0,16,0,0"/>

                        <TextBlock Text="簡報生成器（快速版）"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#444"
                                   Margin="0,14,0,8"/>

                        <StackPanel>
                            <RadioButton x:Name="PresentationEngineClaude"
                                         GroupName="PresentationEngine"
                                         Content="Claude（建議）"
                                         FontSize="12.5"
                                         Foreground="#333"
                                         Margin="0,3"
                                         Checked="PresentationEngine_Checked"/>
                            <RadioButton x:Name="PresentationEngineGpt"
                                         GroupName="PresentationEngine"
                                         Content="GPT"
                                         FontSize="12.5"
                                         Foreground="#333"
                                         Margin="0,3"
                                         Checked="PresentationEngine_Checked"/>
                        </StackPanel>

                        <!-- 影片風格 -->
                        <Border Height="1" Background="#ECECEC" Margin="0,16,0,0"/>

                        <TextBlock Text="影片設定"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#444"
                                   Margin="0,14,0,2"/>

                        <TextBlock Text="模型"
                                   FontSize="12"
                                   Foreground="#666"
                                   Margin="0,8,0,4"/>
                        <ComboBox x:Name="VideoModelTierCombo"
                                  Style="{StaticResource RoutingComboBoxStyle}"
                                  Width="260"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="VideoModelTierCombo_SelectionChanged">
                            <ComboBoxItem Tag="Standard" Style="{StaticResource RoutingComboItemStyle}" Content="Veo 3.1 標準版（約 US$0.40/秒）"/>
                            <ComboBoxItem Tag="Fast" Style="{StaticResource RoutingComboItemStyle}" Content="Veo 3.1 Fast（約 US$0.10/秒）"/>
                            <ComboBoxItem Tag="Lite" Style="{StaticResource RoutingComboItemStyle}" Content="Veo 3.1 Lite（約 US$0.05/秒）"/>
                        </ComboBox>

                        <TextBlock Text="風格"
                                   FontSize="12"
                                   Foreground="#666"
                                   Margin="0,12,0,4"/>

                        <Border CornerRadius="10"
                                Background="#F7F7F8"
                                BorderBrush="#E4E4E7"
                                BorderThickness="1"
                                Padding="10,8">
                            <TextBox x:Name="VideoStyleInput"
                                     MinHeight="120"
                                     MaxHeight="220"
                                     FontSize="12.5"
                                     Foreground="#222"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     LostFocus="VideoStyleInput_LostFocus"/>
                        </Border>

                        <Button x:Name="ResetVideoStyleButton"
                                Content="恢復原廠預設風格"
                                Height="32"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                FontSize="12.5"
                                Cursor="Hand"
                                Background="#F1F1F3"
                                Foreground="#444"
                                BorderThickness="0"
                                Click="ResetVideoStyle_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="16,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#E4E4E7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 任務 → AI 自訂路由 -->
                        <Border Height="1" Background="#ECECEC" Margin="0,16,0,0"/>

                        <TextBlock Text="任務指定模型"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#444"
                                   Margin="0,14,0,8"/>

                        <StackPanel x:Name="TaskRoutingList"/>

                        <Border Height="1" Background="#ECECEC" Margin="0,16,0,0"/>

                        <TextBlock Text="產出檔案"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#444"
                                   Margin="0,14,0,0"/>
                        <Grid Margin="0,12,0,0" ToolTip="簡報、報告、表格除了原始檔外再產一份 PDF。關閉可明顯加快產出與單頁編輯；已經有 PDF 的舊檔仍會跟著更新，以免兩份內容對不起來。">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="同時產出對照 PDF"
                                       FontSize="12.5" Foreground="#333"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <CheckBox x:Name="CompanionPdfSwitch"
                                      Grid.Column="1"
                                      Style="{StaticResource AppleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Checked="CompanionPdfSwitch_Changed"
                                      Unchecked="CompanionPdfSwitch_Changed"/>
                        </Grid>

                        <!-- 存放位置：產出的檔案本來就不隨聊天刪除消失（它們在所有存檔共用的資料夾），
                             但使用者看不出這件事，也會想把成品放到自己的位置（雲端同步、交作業的資料夾）。 -->
                        <TextBlock Text="存放位置"
                                   FontSize="12.5" Foreground="#333"
                                   Margin="0,14,0,4"/>
                        <Border Background="#F7F7F8" BorderBrush="#E4E4E7" BorderThickness="1"
                                CornerRadius="9" Padding="10,7">
                            <TextBlock x:Name="OutputDirText"
                                       Text=""
                                       FontSize="11.5" Foreground="#5F6368"
                                       TextWrapping="Wrap" LineHeight="17"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="變更…" Height="30" Margin="0,0,6,0"
                                    FontSize="12" Cursor="Hand" Foreground="White" BorderThickness="0"
                                    Background="#1F1F1C" Click="ChangeOutputDir_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                CornerRadius="9" Padding="14,0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              TextElement.Foreground="White"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#3A3A35"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="開啟資料夾" Height="30" Margin="0,0,6,0" Padding="12,0"
                                    FontSize="12" Cursor="Hand" Foreground="#66665F"
                                    Background="#F4F4F0" BorderThickness="0"
                                    Click="OpenOutputDir_Click"/>
                            <Button Content="還原預設" Height="30" Padding="12,0"
                                    FontSize="12" Cursor="Hand" Foreground="#8A8A82"
                                    Background="Transparent" BorderThickness="0"
                                    Click="ResetOutputDir_Click"/>
                        </StackPanel>

                        <Border Height="1" Background="#ECECEC" Margin="0,16,0,0"/>

                        <TextBlock Text="畫面"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#444"
                                   Margin="0,14,0,0"/>
                        <Grid Margin="0,12,0,0" ToolTip="每次執行用了哪個模型、為什麼選它、花了多少、根據哪些記憶。關掉只影響顯示，紀錄仍然會留下。">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="右上角顯示決策視窗"
                                       FontSize="12.5" Foreground="#333"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <CheckBox x:Name="DecisionPanelSwitch"
                                      Grid.Column="1"
                                      Style="{StaticResource AppleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Checked="DecisionPanelSwitch_Changed"
                                      Unchecked="DecisionPanelSwitch_Changed"/>
                        </Grid>
                        <Grid Margin="0,12,0,0" ToolTip="各家都沒有查餘額的 API，這裡用「你填的餘額 − 本機記到的花費」推估；充值後到 API 分頁更新金額。">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="右下角顯示 API 餘額"
                                       FontSize="12.5" Foreground="#333"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <CheckBox x:Name="ApiBalancePanelSwitch"
                                      Grid.Column="1"
                                      Style="{StaticResource AppleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Checked="ApiBalancePanelSwitch_Changed"
                                      Unchecked="ApiBalancePanelSwitch_Changed"/>
                        </Grid>

                        <Border Height="1" Background="#ECECEC" Margin="0,16,0,0"/>

                        <TextBlock Text="成本控制"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#444"
                                   Margin="0,14,0,0"/>
                        <TextBlock Text="只影響自動選模型（Auto）；手動選的不受影響。"
                                   FontSize="11.5"
                                   Foreground="#9A9A9E"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                        <Grid Margin="0,12,0,0" ToolTip="Auto 不會選用，改用 Claude Sonnet。">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="關閉 Claude Opus（高成本）"
                                       FontSize="12.5" Foreground="#333"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <CheckBox x:Name="BlockOpusSwitch"
                                      Grid.Column="1"
                                      Style="{StaticResource AppleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Checked="BlockOpusSwitch_Changed"
                                      Unchecked="BlockOpusSwitch_Changed"/>
                        </Grid>
                        <Grid Margin="0,12,0,0" ToolTip="Auto 不會選用，改用 Perplexity Sonar。">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="關閉 Perplexity Deep Research（高成本）"
                                       FontSize="12.5" Foreground="#333"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <CheckBox x:Name="BlockDeepResearchSwitch"
                                      Grid.Column="1"
                                      Style="{StaticResource AppleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Checked="BlockDeepResearchSwitch_Changed"
                                      Unchecked="BlockDeepResearchSwitch_Changed"/>
                        </Grid>

                        <Border Height="1" Background="#ECECEC" Margin="0,16,0,0"/>

                        <TextBlock Text="上游附件"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#444"
                                   Margin="0,14,0,0"/>
                        <Grid Margin="0,12,0,0" ToolTip="開啟時讀取完整上游檔案，關閉時只讀取上游節點的文字輸出。">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="完整讀取上游附件"
                                       FontSize="12.5" Foreground="#333"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <CheckBox x:Name="ReadUpstreamAttachmentsSwitch"
                                      Grid.Column="1"
                                      Style="{StaticResource AppleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Checked="ReadUpstreamAttachmentsSwitch_Changed"
                                      Unchecked="ReadUpstreamAttachmentsSwitch_Changed"/>
                        </Grid>

                        <!-- §15 逾時上限 -->
                        <Border Height="1" Background="#ECECEC" Margin="0,16,0,0"/>

                        <TextBlock Text="逾時上限"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#444"
                                   Margin="0,14,0,2"/>
                        <TextBlock Text="設定範圍 30～1800 秒（留空＝自動）"
                                   FontSize="11.5"
                                   Foreground="#9A9A9E"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#F7F7F8"
                                    BorderBrush="#E4E4E7"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Width="96"
                                    Height="34">
                                <TextBox x:Name="TimeoutInput"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         Padding="12,0"
                                         FontSize="12.5"
                                         Foreground="#333"
                                         MaxLength="4"
                                         TextChanged="TimeoutInput_Changed"/>
                            </Border>
                            <TextBlock Text="秒"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       FontSize="12.5"
                                       Foreground="#666"/>
                            <TextBlock Text="（留空＝自動）"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontSize="11.5"
                                       Foreground="#A8A8AC"/>
                        </StackPanel>

                        <!-- 花錢安全：今日累計花費 + 每日上限（0/留空 = 不限制） -->
                        <Border Height="1" Background="#ECECEC" Margin="0,16,0,0"/>

                        <TextBlock Text="花費"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#444"
                                   Margin="0,14,0,2"/>
                        <TextBlock Text="達上限之後不再執行新開始的任務"
                                   FontSize="11.5"
                                   Foreground="#9A9A9E"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <TextBlock x:Name="SpendTodayText"
                                   Text="今日已花：約 NT$0"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#333"
                                   Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="每日上限"
                                       VerticalAlignment="Center"
                                       FontSize="12.5"
                                       Foreground="#333"
                                       Margin="0,0,10,0"/>
                            <Border Background="#F7F7F8"
                                    BorderBrush="#E4E4E7"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Width="96"
                                    Height="34">
                                <TextBox x:Name="DailyBudgetInput"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         Padding="12,0"
                                         FontSize="12.5"
                                         Foreground="#333"
                                         MaxLength="6"
                                         TextChanged="DailyBudgetInput_Changed"/>
                            </Border>
                            <TextBlock Text="NT$／天"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       FontSize="12.5"
                                       Foreground="#666"/>
                            <TextBlock Text="（留空＝不限制）"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontSize="11.5"
                                       Foreground="#A8A8AC"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Text="確認框自動同意"
                                       VerticalAlignment="Center"
                                       FontSize="12.5"
                                       Foreground="#333"
                                       Margin="0,0,10,0"/>
                            <Border Background="#F7F7F8"
                                    BorderBrush="#E4E4E7"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Width="72"
                                    Height="34">
                                <TextBox x:Name="AutoConfirmSecondsInput"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         Padding="12,0"
                                         FontSize="12.5"
                                         Foreground="#333"
                                         MaxLength="3"
                                         TextChanged="AutoConfirmSecondsInput_Changed"/>
                            </Border>
                            <TextBlock Text="秒後自動執行"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       FontSize="12.5"
                                       Foreground="#666"/>
                            <TextBlock Text="（0＝全手動）"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontSize="11.5"
                                       Foreground="#A8A8AC"/>
                        </StackPanel>

                        <!-- §18 雲端上傳：產出檔案自動上傳 Google Drive（各類型可個別開關） -->
                        <Border Height="1" Background="#ECECEC" Margin="0,16,0,0"/>

                        <Grid Margin="0,14,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="產出檔案上傳 Google Drive"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#444"/>
                                <TextBlock Text="需已連結帳戶（「API」分頁的「Google 整合」區）"
                                           FontSize="11" Foreground="#A8A8AC" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="GoogleAutoUploadSwitch"
                                      Grid.Column="1"
                                      Style="{StaticResource AppleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Checked="GoogleAutoUploadSwitch_Changed"
                                      Unchecked="GoogleAutoUploadSwitch_Changed"/>
                        </Grid>

                        <!-- 檔案類型：膠囊 chip（點一下切換），包在淺灰卡片裡比裸 checkbox 清楚 -->
                        <Border Background="#FAFAFC" CornerRadius="10" Padding="12,10,12,4" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="要上傳的檔案類型"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <CheckBox x:Name="DriveTypePdf"   Content="PDF"   Tag="pdf"   Style="{StaticResource ChoiceChipStyle}" Checked="DriveTypeCheck_Changed" Unchecked="DriveTypeCheck_Changed"/>
                                    <CheckBox x:Name="DriveTypeWord"  Content="Word"  Tag="word"  Style="{StaticResource ChoiceChipStyle}" Checked="DriveTypeCheck_Changed" Unchecked="DriveTypeCheck_Changed"/>
                                    <CheckBox x:Name="DriveTypePpt"   Content="簡報"  Tag="ppt"   Style="{StaticResource ChoiceChipStyle}" Checked="DriveTypeCheck_Changed" Unchecked="DriveTypeCheck_Changed"/>
                                    <CheckBox x:Name="DriveTypeExcel" Content="Excel" Tag="excel" Style="{StaticResource ChoiceChipStyle}" Checked="DriveTypeCheck_Changed" Unchecked="DriveTypeCheck_Changed"/>
                                    <CheckBox x:Name="DriveTypeImage" Content="圖片"  Tag="image" Style="{StaticResource ChoiceChipStyle}" Checked="DriveTypeCheck_Changed" Unchecked="DriveTypeCheck_Changed"/>
                                    <CheckBox x:Name="DriveTypeVideo" Content="影片"  Tag="video" Style="{StaticResource ChoiceChipStyle}" Checked="DriveTypeCheck_Changed" Unchecked="DriveTypeCheck_Changed"/>
                                    <CheckBox x:Name="DriveTypeText"  Content="文字/MD" Tag="text" Style="{StaticResource ChoiceChipStyle}" Checked="DriveTypeCheck_Changed" Unchecked="DriveTypeCheck_Changed"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Word／Excel 轉成 Google 文件／試算表"
                                           FontSize="12.5" Foreground="#333"/>
                                <TextBlock Text="上傳時由 Drive 轉檔，變成可線上編輯的 Google 格式"
                                           FontSize="11" Foreground="#A8A8AC"/>
                            </StackPanel>
                            <CheckBox x:Name="DriveConvertSwitch"
                                      Grid.Column="1"
                                      Style="{StaticResource AppleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Checked="DriveConvertSwitch_Changed"
                                      Unchecked="DriveConvertSwitch_Changed"/>
                        </Grid>

                        <!-- 手機鏡像（§17 階段一）：開啟後手機同區網可唯讀看到畫布即時狀態 -->
                        <Border Height="1" Background="#ECECEC" Margin="0,16,0,0"/>

                        <TextBlock Text="手機鏡像"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#444"
                                   Margin="0,14,0,2"/>
                        <TextBlock Text="手機連接同一 Wi-Fi 時，可在手機上操作"
                                   FontSize="11.5"
                                   Foreground="#9A9A9E"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="啟用手機唯讀鏡像"
                                           FontSize="12.5" Foreground="#333"/>
                                <TextBlock Text="關閉時不開任何對外連線埠"
                                           FontSize="11" Foreground="#A8A8AC"/>
                            </StackPanel>
                            <CheckBox x:Name="MobileMirrorSwitch"
                                      Grid.Column="1"
                                      Style="{StaticResource AppleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Checked="MobileMirrorSwitch_Changed"
                                      Unchecked="MobileMirrorSwitch_Changed"/>
                        </Grid>

                        <Border x:Name="MobileMirrorUrlBox"
                                Visibility="Collapsed"
                                Background="#F4F5FB"
                                CornerRadius="10"
                                Padding="12,10"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="手機相機掃這個 QR 直接進，或手打下方網址："
                                           FontSize="11.5" Foreground="#777" Margin="0,0,0,8"/>
                                <Border HorizontalAlignment="Center"
                                        Background="White"
                                        CornerRadius="8"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <Image x:Name="MobileMirrorQr"
                                           Width="150" Height="150"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           SnapsToDevicePixels="True"/>
                                </Border>
                                <TextBox x:Name="MobileMirrorUrlText"
                                         Text=""
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Foreground="#3B54FF"
                                         TextWrapping="Wrap"
                                         HorizontalAlignment="Center"
                                         TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                    </ScrollViewer>

                    <!-- §19 技能分頁（可捲動）：與 API 同級的獨立分頁；技能＝可重複使用的指示/能力，執行時自動注入 prompt -->
                    <ScrollViewer x:Name="SkillsScroll"
                                  Grid.Row="2"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="2,10,2,6">
                        <TextBlock Text="Skills"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#444"
                                   Margin="0,4,0,2"/>
                        <TextBlock Text="把常用的指示、流程或格式模板存成「技能」，每次執行任務時自動注入給 AI。全域生效、跨專案、重啟保留；可個別開關。與本節點明確指示衝突時，以節點為準。"
                                   FontSize="11.5"
                                   Foreground="#9A9A9E"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="新增技能"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,4"/>
                        <Border Background="#F7F7F8" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="9" Margin="0,0,0,6">
                            <TextBox x:Name="SkillNameInput"
                                     BorderThickness="0" Background="Transparent"
                                     Padding="12,8" FontSize="12.5" Foreground="#333"
                                     VerticalContentAlignment="Center"
                                     ToolTip="技能名稱（例：週報格式）"/>
                        </Border>
                        <Border Background="#F7F7F8" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="9" Margin="0,0,0,8">
                            <TextBox x:Name="SkillContentInput"
                                     BorderThickness="0" Background="Transparent"
                                     Padding="12,8" FontSize="12.5" Foreground="#333"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="64" MaxHeight="160"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="技能內容：要注入給 AI 的指示/流程/格式模板"/>
                        </Border>
                        <Button x:Name="AddSkillButton"
                                Content="＋ 新增技能"
                                Height="34" FontSize="13" FontWeight="SemiBold"
                                Cursor="Hand" Background="#111" Foreground="White" BorderThickness="0"
                                Click="AddSkill_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextElement.Foreground="White"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#333"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 從 GitHub 匯入（支援 raw / blob 連結的 .md 或純文字技能檔；SKILL.md frontmatter 的 name 會自動帶入） -->
                        <Border Height="1" Background="#ECECEC" Margin="0,16,0,0"/>
                        <TextBlock Text="從 GitHub 匯入"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="#555" Margin="0,14,0,2"/>
                        <TextBlock Text="貼上 GitHub 上技能檔的連結（blob 或 raw 皆可，例如 SKILL.md），自動抓取並匯入成一條技能。frontmatter 的 name/description 會自動解析。"
                                   FontSize="11.5" Foreground="#9A9A9E" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F7F7F8" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="9">
                                <TextBox x:Name="SkillImportUrlInput"
                                         BorderThickness="0" Background="Transparent"
                                         Padding="12,8" FontSize="12" Foreground="#333"
                                         VerticalContentAlignment="Center"
                                         ToolTip="https://github.com/…/SKILL.md 或 raw.githubusercontent.com 連結"/>
                            </Border>
                            <Button x:Name="ImportSkillButton"
                                    Grid.Column="2"
                                    Content="匯入"
                                    Height="34" Width="72" FontSize="13" FontWeight="SemiBold"
                                    Cursor="Hand" Background="#111" Foreground="White" BorderThickness="0"
                                    Click="ImportSkillFromGitHub_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              TextElement.Foreground="White"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#333"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="SkillImportHint"
                                   Text=""
                                   FontSize="11.5" Foreground="#9A9A9E" TextWrapping="Wrap" Margin="2,6,0,0"/>

                        <!-- 已存在的技能清單 -->
                        <Border Height="1" Background="#ECECEC" Margin="0,16,0,0"/>
                        <TextBlock Text="我的技能"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="#555" Margin="0,14,0,6"/>
                        <StackPanel x:Name="SkillsListPanel"/>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- API 分頁（可捲動）：使用者可把自己的金鑰寫進程式，免設環境變數 -->
                    <ScrollViewer x:Name="ApiScroll"
                                  Grid.Row="2"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,8,0,0">
                        <StackPanel Margin="0,8,4,0">
                            <!-- 狀態本來就由 ProviderStatusMonitor 即時推上來，不需要手動檢查鈕；
                                 說明搬到右上角的「?」使用說明。 -->
                            <TextBlock Text="API 餘額"
                                       FontSize="14" FontWeight="SemiBold" Foreground="#2A2A28"
                                       Margin="0,0,0,14"/>

                            <ItemsControl x:Name="ApiStatusList" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" CornerRadius="12" Padding="16,13" Margin="0,0,0,10"
                                                BorderBrush="#EAEAE6" BorderThickness="1">
                                            <StackPanel>
                                                <!-- 第一行：燈號 + 服務名（左）、目前餘額（右） -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 這顆點一直沒有任何說明，而且會變色；使用者看不出它在講什麼。 -->
                                                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                                             Margin="0,1,9,0" Fill="{Binding Dot}"
                                                             ToolTip="這個服務現在的狀態&#10;綠＝可用　黃＝接近用完或被限流　紅＝餘額不足／金鑰無效／連不上　灰＝還沒檢查過&#10;每次真的呼叫成功或失敗都會即時更新，也可以按上面的「重新檢查」"/>

                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                               FontSize="13" FontWeight="SemiBold" Foreground="#2A2A28"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                    <TextBlock Grid.Column="2" Text="{Binding BalanceText}"
                                                               FontSize="16" FontWeight="SemiBold" Foreground="#1F1F1C"
                                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                </Grid>

                                                <!-- 餘額是本機估的，就要說清楚是從哪天起估的 -->
                                                <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="#A8A8A1"
                                                           TextWrapping="Wrap" Margin="17,4,0,0" LineHeight="16"/>

                                                <!-- 只有出問題才出現的一行 -->
                                                <TextBlock Text="{Binding Problem}" FontSize="11.5" Foreground="#C0453B"
                                                           TextWrapping="Wrap" Margin="17,5,0,0"
                                                           Visibility="{Binding ProblemVisible}"/>

                                                <!-- 操作列：幣別 → 金額 → 送出，最後是帳單頁。
                                                     設定卡只有 440 寬（扣掉內距後約 345），五欄固定寬度會把最後一顆按鈕
                                                     整個推出可視範圍——所以只有金額欄吃 *，其餘各自 Auto。 -->
                                                <Grid Margin="17,11,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 跟影片模型選單同一套樣式：系統預設的 ComboBox 在這張白卡上
                                                         是唯一一個長得像 Win32 控制項的東西，整列就被它拉低了。 -->
                                                    <ComboBox Grid.Column="0" Width="78"
                                                              Style="{StaticResource RoutingComboBoxStyle}"
                                                              ToolTip="這個服務向你收費的幣別（照官網帳單填）。改了之後現有餘額會自動換算。"
                                                              ItemsSource="{Binding CurrencyOptions}"
                                                              SelectedItem="{Binding Currency, Mode=OneWay}"
                                                              SelectionChanged="ProviderCurrency_Changed"/>

                                                    <Border Grid.Column="1" Height="32" MinWidth="86" Margin="8,0,0,0"
                                                            CornerRadius="9"
                                                            Background="#F7F7F8" BorderBrush="#E4E4E7" BorderThickness="1">
                                                        <TextBox Text="{Binding TopUp, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontSize="13" Padding="9,0" VerticalContentAlignment="Center"
                                                                 Background="Transparent" BorderThickness="0"
                                                                 ToolTip="填官網現在顯示的餘額（例 20）。清空後送出＝不再追蹤這個服務。"
                                                                 KeyDown="ProviderTopUp_KeyDown"/>
                                                    </Border>

                                                    <Button Grid.Column="2" Content="送出" Height="32" Margin="8,0,0,0"
                                                            FontSize="12" Cursor="Hand" Foreground="White" BorderThickness="0"
                                                            Background="#1F1F1C"
                                                            ToolTip="把餘額改成左邊填的數字，並以此刻為新的對帳起點"
                                                            Click="ProviderTopUpSubmit_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                                        CornerRadius="9" Padding="14,0">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                      TextElement.Foreground="White"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="#3A3A35"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <Button Grid.Column="3" Content="帳單頁" Height="32" Margin="4,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="12" Cursor="Hand" Foreground="#8A8A82" BorderThickness="0"
                                                            Background="Transparent"
                                                            ToolTip="開啟這個服務的官方帳單頁，查目前真正的餘額"
                                                            Tag="{Binding BillingUrl}" Click="OpenBillingPage_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                                        CornerRadius="9" Padding="9,0">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="#F2F2EE"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="API 金鑰"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#444"
                                       Margin="0,0,0,2"/>
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="11.5"
                                       Foreground="#9A9A9E"
                                       Margin="0,0,0,12">
                                <Run Text="解析順序：系統環境變數 → 這裡輸入的金鑰 → 都沒有就自動切換到其他可用模型（顯示於決策窗），全部不可用才回報失敗。"/>
                            </TextBlock>

                            <!-- OpenAI -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="OpenAI" FontSize="12.5" FontWeight="SemiBold" Foreground="#333"/>
                                    <TextBlock Text="（GPT 文字、gpt-image 圖片）" FontSize="11" Foreground="#A8A8AC" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="ApiStatus_OpenAI" Grid.Column="1" Text="未設定" FontSize="11" Foreground="#A8A8AC" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,-6,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="9" Background="#F7F7F8" BorderBrush="#E4E4E7" BorderThickness="1" Padding="10,2">
                                    <PasswordBox x:Name="ApiKeyBox_OpenAI" Height="30" FontSize="12.5" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="1" Content="清除" Tag="OPENAI_API_KEY" Height="30" Margin="8,0,0,0" Padding="12,0" FontSize="11.5" Cursor="Hand" Background="#F1F1F3" Foreground="#666" BorderThickness="0" Click="ClearApiKey_Click">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                </Button>
                            </Grid>

                            <!-- Claude -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Claude" FontSize="12.5" FontWeight="SemiBold" Foreground="#333"/>
                                    <TextBlock Text="（Anthropic 文字 / 導演 / 程式碼）" FontSize="11" Foreground="#A8A8AC" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="ApiStatus_Anthropic" Grid.Column="1" Text="未設定" FontSize="11" Foreground="#A8A8AC" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,-6,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="9" Background="#F7F7F8" BorderBrush="#E4E4E7" BorderThickness="1" Padding="10,2">
                                    <PasswordBox x:Name="ApiKeyBox_Anthropic" Height="30" FontSize="12.5" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="1" Content="清除" Tag="ANTHROPIC_API_KEY" Height="30" Margin="8,0,0,0" Padding="12,0" FontSize="11.5" Cursor="Hand" Background="#F1F1F3" Foreground="#666" BorderThickness="0" Click="ClearApiKey_Click">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                </Button>
                            </Grid>

                            <!-- Gemini -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Gemini" FontSize="12.5" FontWeight="SemiBold" Foreground="#333"/>
                                    <TextBlock Text="（Google 文字、Veo 影片）" FontSize="11" Foreground="#A8A8AC" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="ApiStatus_Gemini" Grid.Column="1" Text="未設定" FontSize="11" Foreground="#A8A8AC" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,-6,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="9" Background="#F7F7F8" BorderBrush="#E4E4E7" BorderThickness="1" Padding="10,2">
                                    <PasswordBox x:Name="ApiKeyBox_Gemini" Height="30" FontSize="12.5" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="1" Content="清除" Tag="GEMINI_API_KEY" Height="30" Margin="8,0,0,0" Padding="12,0" FontSize="11.5" Cursor="Hand" Background="#F1F1F3" Foreground="#666" BorderThickness="0" Click="ClearApiKey_Click">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                </Button>
                            </Grid>

                            <!-- Perplexity -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Perplexity" FontSize="12.5" FontWeight="SemiBold" Foreground="#333"/>
                                    <TextBlock Text="（即時聯網研究 / 來源查證）" FontSize="11" Foreground="#A8A8AC" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="ApiStatus_Perplexity" Grid.Column="1" Text="未設定" FontSize="11" Foreground="#A8A8AC" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,-6,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="9" Background="#F7F7F8" BorderBrush="#E4E4E7" BorderThickness="1" Padding="10,2">
                                    <PasswordBox x:Name="ApiKeyBox_Perplexity" Height="30" FontSize="12.5" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="1" Content="清除" Tag="PERPLEXITY_API_KEY" Height="30" Margin="8,0,0,0" Padding="12,0" FontSize="11.5" Cursor="Hand" Background="#F1F1F3" Foreground="#666" BorderThickness="0" Click="ClearApiKey_Click">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                </Button>
                            </Grid>

                            <!-- Google OAuth（Drive 整合；桌面應用程式用戶端） -->
                            <Grid Margin="0,6,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Google Client ID" FontSize="12.5" FontWeight="SemiBold" Foreground="#333"/>
                                    <TextBlock Text="（Drive 整合，見下方「Google 整合」區）" FontSize="11" Foreground="#A8A8AC" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="ApiStatus_GoogleClientId" Grid.Column="1" Text="未設定" FontSize="11" Foreground="#A8A8AC" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,-6,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="9" Background="#F7F7F8" BorderBrush="#E4E4E7" BorderThickness="1" Padding="10,2">
                                    <PasswordBox x:Name="ApiKeyBox_GoogleClientId" Height="30" FontSize="12.5" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="1" Content="清除" Tag="GOOGLE_OAUTH_CLIENT_ID" Height="30" Margin="8,0,0,0" Padding="12,0" FontSize="11.5" Cursor="Hand" Background="#F1F1F3" Foreground="#666" BorderThickness="0" Click="ClearApiKey_Click">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                </Button>
                            </Grid>

                            <Grid Margin="0,6,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Google Client Secret" FontSize="12.5" FontWeight="SemiBold" Foreground="#333" Grid.Column="0"/>
                                <TextBlock x:Name="ApiStatus_GoogleClientSecret" Grid.Column="1" Text="未設定" FontSize="11" Foreground="#A8A8AC" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,-6,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="9" Background="#F7F7F8" BorderBrush="#E4E4E7" BorderThickness="1" Padding="10,2">
                                    <PasswordBox x:Name="ApiKeyBox_GoogleClientSecret" Height="30" FontSize="12.5" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="1" Content="清除" Tag="GOOGLE_OAUTH_CLIENT_SECRET" Height="30" Margin="8,0,0,0" Padding="12,0" FontSize="11.5" Cursor="Hand" Background="#F1F1F3" Foreground="#666" BorderThickness="0" Click="ClearApiKey_Click">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                </Button>
                            </Grid>

                            <Button x:Name="SaveApiKeysButton"
                                    Content="儲存 API 金鑰"
                                    Height="36"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Background="#111"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="SaveApiKeys_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="sbd" Background="{TemplateBinding Background}" CornerRadius="9">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="sbd" Property="Background" Value="#333"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <TextBlock x:Name="ApiSaveHint"
                                       Text=""
                                       FontSize="11.5"
                                       Foreground="#1F9D55"
                                       Margin="2,8,0,0"
                                       Visibility="Collapsed"/>

                            <!-- §18 Google 整合：連結帳戶 + 產出自動上傳 Drive -->
                            <Border Height="1" Background="#ECECEC" Margin="0,18,0,0"/>
                            <TextBlock Text="Google 整合"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#444" Margin="0,14,0,2"/>
                            <TextBlock Text="連結 Google 帳戶後，產出的檔案（PDF／PPTX／DOCX／圖片／影片）可自動存到你的 Drive。授權採最小權限（只碰本程式建立的檔案），憑證與 token 皆只存本機。"
                                       FontSize="11.5" Foreground="#9A9A9E" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock x:Name="GoogleStatusText"
                                       Text="狀態：檢查中…"
                                       FontSize="12" Foreground="#666" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="GoogleAuthBtn"
                                        Content="連結 Google"
                                        Height="32" FontSize="12.5" FontWeight="SemiBold"
                                        Cursor="Hand" Background="#111" Foreground="White" BorderThickness="0"
                                        Margin="0,0,8,0"
                                        Click="GoogleAuth_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="16,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  TextElement.Foreground="White"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="GoogleUnlinkBtn"
                                        Content="解除連結"
                                        Height="32" FontSize="12.5"
                                        Cursor="Hand" Background="#F1F1F3" Foreground="#666" BorderThickness="0"
                                        Click="GoogleUnlink_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="16,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="上傳偏好（開關／各檔案類型／轉 Google 格式）在「個人化」分頁的「雲端上傳」區設定。"
                                       FontSize="11.5" Foreground="#9A9A9E" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Artifact 即時預覽 overlay（點檔案 chip 開啟）-->
        <Grid x:Name="PreviewOverlay"
              Visibility="Collapsed"
              Panel.ZIndex="11000"
              Background="#66000000"
              MouseLeftButtonDown="PreviewOverlay_BackgroundClick">

            <Border Margin="56"
                    CornerRadius="16"
                    Background="White"
                    BorderBrush="#E6E6E6"
                    BorderThickness="1"
                    MouseLeftButtonDown="PreviewCard_Click">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.25"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 標題列 -->
                    <Grid Grid.Row="0" Margin="20,14,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="預覽"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#303030"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   x:Name="PreviewFileName"
                                   Margin="12,0,12,0"
                                   FontSize="13"
                                   Foreground="#8A8A8E"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <Button Grid.Column="2"
                                x:Name="PreviewOpenExternalButton"
                                Content="用系統程式開啟"
                                Height="30"
                                FontSize="12.5"
                                Foreground="#444"
                                Background="#F1F1F3"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,8,0"
                                Click="PreviewOpenExternal_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="pob" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="pob" Property="Background" Value="#E4E4E7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="3"
                                Width="30" Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="關閉"
                                Click="ClosePreview_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="pcb" Background="Transparent" CornerRadius="8">
                                        <Path Data="M5,5 L15,15 M15,5 L5,15"
                                              Stroke="#888"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="pcb" Property="Background" Value="#EEEEEE"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- 重新生成：可直接在這裡補上或修改指示（例：第 3 頁改成表格、整體更活潑） -->
                    <Border x:Name="PreviewRegenBar"
                            Grid.Row="2"
                            Visibility="Collapsed"
                            Background="#F7F7F8"
                            CornerRadius="0,0,16,16"
                            BorderBrush="#ECECEC"
                            BorderThickness="0,1,0,0"
                            Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="White"
                                    CornerRadius="9"
                                    BorderBrush="#E4E4E7"
                                    BorderThickness="1"
                                    Padding="10,6">
                                <Grid>
                                    <TextBlock x:Name="PreviewRegenHint"
                                               Text="想改什麼？例如：第 3 頁改成比較表、整體更活潑、多加一頁結論（留空＝用原需求重做一次）"
                                               FontSize="12"
                                               Foreground="#B0B0B6"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"/>
                                    <TextBox x:Name="PreviewRegenInput"
                                             FontSize="12.5"
                                             Foreground="#222"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             TextWrapping="Wrap"
                                             MaxHeight="72"
                                             VerticalScrollBarVisibility="Auto"
                                             AcceptsReturn="True"
                                             TextChanged="PreviewRegenInput_TextChanged"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                    x:Name="PreviewPageBox"
                                    Background="White"
                                    CornerRadius="9"
                                    BorderBrush="#E4E4E7"
                                    BorderThickness="1"
                                    Padding="10,6"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="只重做某一頁時填頁碼；留空＝整份重做">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="第" FontSize="11.5" Foreground="#9A9A9E" VerticalAlignment="Center"/>
                                    <TextBox x:Name="PreviewRegenPage"
                                             Width="30"
                                             FontSize="12.5"
                                             Foreground="#222"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             TextAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Margin="4,0,4,0"/>
                                    <TextBlock Text="頁" FontSize="11.5" Foreground="#9A9A9E" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="PreviewUndoButton"
                                    Grid.Column="2"
                                    Content="上一版"
                                    Height="34"
                                    Margin="8,0,0,0"
                                    Padding="14,0"
                                    FontSize="12.5"
                                    Cursor="Hand"
                                    Background="#F1F1F3"
                                    Foreground="#555"
                                    BorderThickness="0"
                                    IsEnabled="False"
                                    ToolTip="新版不如舊版時，退回上一個版本"
                                    Click="PreviewUndo_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="pub" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="pub" Property="Background" Value="#E6E6E9"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="pub" Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="PreviewRedoButton"
                                    Grid.Column="3"
                                    Content="下一版"
                                    Height="34"
                                    Margin="6,0,0,0"
                                    Padding="14,0"
                                    FontSize="12.5"
                                    Cursor="Hand"
                                    Background="#F1F1F3"
                                    Foreground="#555"
                                    BorderThickness="0"
                                    IsEnabled="False"
                                    ToolTip="退回之後又想要新版時，前進回去（不用重新生成）"
                                    Click="PreviewRedo_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="prdb" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="prdb" Property="Background" Value="#E6E6E9"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="prdb" Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="PreviewRegenButton"
                                    Grid.Column="4"
                                    Content="重新生成"
                                    Height="34"
                                    Margin="10,0,0,0"
                                    Padding="18,0"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Background="#111"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="PreviewRegenerate_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="prb" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="prb" Property="Background" Value="#333"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="prb" Property="Background" Value="#C9CDD4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 內容區：依檔案類型只顯示其中一個渲染器 -->
                    <Border Grid.Row="1" Background="#FAFAFA" ClipToBounds="True">
                        <Grid x:Name="PreviewContentHost">

                            <ScrollViewer x:Name="PreviewImageScroll"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <Image x:Name="PreviewImage"
                                       Margin="16"
                                       Stretch="Uniform"
                                       StretchDirection="DownOnly"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </ScrollViewer>

                            <MediaElement x:Name="PreviewMedia"
                                          Visibility="Collapsed"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Stop"
                                          Stretch="Uniform"
                                          Margin="16"
                                          Cursor="Hand"
                                          MediaOpened="PreviewMedia_MediaOpened"
                                          MediaEnded="PreviewMedia_MediaEnded"
                                          MouseLeftButtonDown="PreviewMedia_Click"/>

                            <wv2:WebView2 x:Name="PreviewWeb"
                                          Visibility="Collapsed"/>

                            <ScrollViewer x:Name="PreviewTextScroll"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="PreviewTextScroll_PreviewMouseWheel">
                                <TextBox x:Name="PreviewText"
                                         Margin="28,22,28,22"
                                         FontSize="15"
                                         Foreground="#222"
                                         TextWrapping="Wrap"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CaretBrush="Transparent"
                                         IsReadOnlyCaretVisible="False"
                                         VerticalScrollBarVisibility="Disabled"
                                         HorizontalScrollBarVisibility="Disabled"/>
                            </ScrollViewer>

                            <StackPanel x:Name="PreviewFallback"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="PreviewFallbackText"
                                           Text="這個檔案無法在這裡預覽。"
                                           FontSize="14"
                                           Foreground="#888"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock x:Name="PreviewLoading"
                                       Text="載入中…"
                                       Visibility="Collapsed"
                                       FontSize="14"
                                       Foreground="#999"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
